{
  "$class": "org.accordproject.commonmark@0.5.0.Document",
  "xmlns": "http://commonmark.org/xml/1.0",
  "nodes": [
    {
      "$class": "org.accordproject.templatemark@0.5.0.ContractDefinition",
      "name": "top",
